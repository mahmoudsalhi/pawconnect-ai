DATABASE_URL=postgresql+psycopg://pawconnect:CHANGE_ME@localhost:5432/pawconnect
TEST_DATABASE_URL=postgresql+psycopg://pawconnect:CHANGE_ME@localhost:5432/pawconnect_test
JWT_SECRET=generate-a-long-random-string
# "demo" = built-in placeholder models. Use "package.module:ClassName" for your own AIProvider.
AI_PROVIDER=demo
# AI search assistant: reads lost-pet descriptions and writes search plans. Optional.
# Free: create a key at console.groq.com (no credit card). Or use the Claude API instead.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
