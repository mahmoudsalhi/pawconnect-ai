DATABASE_URL=postgresql+psycopg://pawconnect:CHANGE_ME@localhost:5432/pawconnect
TEST_DATABASE_URL=postgresql+psycopg://pawconnect:CHANGE_ME@localhost:5432/pawconnect_test
JWT_SECRET=generate-a-long-random-string
# "demo" = built-in placeholder models. Use "package.module:ClassName" for your own AIProvider.
AI_PROVIDER=demo
# Age model (M4). The .json config must sit next to the .onnx file. Relative to the project root.
M4_AGE_MODEL_PATH=backend/models/m4_age.onnx
# Dog skin model (M5). The .json config must sit next to the .onnx file. Relative to the project root.
M5_SKIN_MODEL_PATH=backend/models/m5_skin.onnx
